# ── dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ── package manager caches / state ───────────────────────────────────────────
.npm/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz
.pnpm-debug.log*

# ── build / pack artifacts ───────────────────────────────────────────────────
dist/
build/
out/
*.tgz
mcplite-*.tgz
.npmignore.bak

# ── test & coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml

# ── mcplite runtime files (project-local, not package source) ────────────────
# These get created by `mcplite init` when you dogfood the tool inside this repo.
# If you *want* to commit a demo batch, un-ignore just that file below.
mcplite-tasks.json
mcplite-tasks-logs.json
!mcplite-guide.md

# ── logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── env / secrets ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── temp / scratch ───────────────────────────────────────────────────────────
tmp/
temp/
.cache/